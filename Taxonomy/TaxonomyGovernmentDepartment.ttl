@prefix : <https://gov.uk/ontology/TaxonomyDepartment#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix gds: <https://gov.uk/ontology/TaxonomyDepartment#gds:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
