#################################################################

###  http://www.w3.org/2002/07/owl#maxQualifiedCardinality
owl:maxQualifiedCardinality rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#minQualifiedCardinality
owl:minQualifiedCardinality rdf:type owl:AnnotationProperty .


#################################################################
#    Classes
#################################################################

###  https://gov.uk/ontology#ContentSchema
<https://gov.uk/ontology#ContentSchema> rdf:type owl:Class ;
                                        rdfs:label "Content Block"@en-gb .


###  https://gov.uk/ontology/ContentSchemaTax#Abbreviation
:Abbreviation rdf:type owl:Class ;
              rdfs:subClassOf :Tax ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty <https://gov.uk/ontology#hasDatatype> ;
                                owl:allValuesFrom xsd:string
                              ] ;
              rdfs:label "Abbreviation"@en-gb .


###  https://gov.uk/ontology/ContentSchemaTax#Description
:Description rdf:type owl:Class ;
             rdfs:subClassOf :Tax ;
             rdfs:label "Description"@en-gb .


###  https://gov.uk/ontology/ContentSchemaTax#InstructionToPublishers
:InstructionToPublishers rdf:type owl:Class ;
                         rdfs:subClassOf :Tax ;
                         rdfs:label "Instructions to publishers"@en-gb .


###  https://gov.uk/ontology/ContentSchemaTax#LeadOrganisation
:LeadOrganisation rdf:type owl:Class ;
                  rdfs:subClassOf :Tax ;
                  rdfs:label "Lead Organisation"@en-gb .


###  https://gov.uk/ontology/ContentSchemaTax#Note
:Note rdf:type owl:Class ;
      rdfs:subClassOf :Tax ;
      rdfs:label "Note"@en-gb .


###  https://gov.uk/ontology/ContentSchemaTax#Part1
:Part1 rdf:type owl:Class ;
       rdfs:subClassOf :InstructionToPublishers ;
       owl:disjointWith :Part2 .


###  https://gov.uk/ontology/ContentSchemaTax#Part2
:Part2 rdf:type owl:Class ;
       rdfs:subClassOf :InstructionToPublishers .


###  https://gov.uk/ontology/ContentSchemaTax#Part3
:Part3 rdf:type owl:Class ;
       rdfs:subClassOf :Note .


###  https://gov.uk/ontology/ContentSchemaTax#Part3a
:Part3a rdf:type owl:Class ;
        rdfs:subClassOf :Part3 .


###  https://gov.uk/ontology/ContentSchemaTax#Synonym
:Synonym rdf:type owl:Class ;
         rdfs:subClassOf :Tax ;
         rdfs:label "Synonym"@en-gb .


###  https://gov.uk/ontology/ContentSchemaTax#Tax
:Tax rdf:type owl:Class ;
     rdfs:subClassOf <https://gov.uk/ontology#ContentSchema> ;
     dc:creator "Marc Stephenson" ;
     dc:date "2025-12-15T10:16:57Z"^^xsd:dateTime ;
     rdfs:label "Tax Content Block"@en-gb .


###  https://gov.uk/ontology/ContentSchemaTax#TaxName
:TaxName rdf:type owl:Class ;
         rdfs:subClassOf :Tax ;
         rdfs:label "Tax Name"@en-gb .


