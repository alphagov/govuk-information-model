<https://gov.uk/ontology/ContentSchemaTax> rdf:type owl:Ontology ;
                                            owl:versionIRI <https://gov.uk/ontology/ContentSchemaTax> ;
                                            owl:imports <https://gov.uk/ontology/Core> .

