<owl:Class rdf:about="http://www.gov.uk/IA/Ontology/ContentType/Answer#DefinitionsAbsolutePath">
	<dc:creator>Marc Stephenson via script</dc:creator>
	<gds:sourcenode>json/definitions/absolute_path</gds:sourcenode>
	<gds:description>A path only. Query string and/or fragment are not allowed.</gds:description>
	<gds:pattern>^/(([a-zA-Z0-9._~!$&amp;'()*+,;=@-]|%[0-9a-fA-F]{2})+(/([a-zA-Z0-9._~!$&amp;'()*+,;=@-]|%[0-9a-fA-F]{2})*)*)?$ [Note: colons removed to fix Protege bug]</gds:pattern>
	<gds:type>string</gds:type>
				<rdfs:subClassOf rdf:resource="http://www.gov.uk/IA/Ontology/ContentType/Answer"/>
</owl:Class>

<owl:Class rdf:about="http://www.gov.uk/IA/Ontology/ContentType/Answer#DefinitionsFirstPublishedAt">
	<dc:creator>Marc Stephenson via script</dc:creator>
	<gds:sourcenode>json/definitions/first_published_at</gds:sourcenode>
	<gds:description>The date the content was first published.  Automatically determined by the publishing-api, unless overridden by the publishing application.</gds:description>
		<gds:type>string</gds:type>
		<gds:format>date-time</gds:format>
		<rdfs:subClassOf rdf:resource="http://www.gov.uk/IA/Ontology/ContentType/Answer"/>
</owl:Class>

<owl:Class rdf:about="http://www.gov.uk/IA/Ontology/ContentType/Answer#DefinitionsGuid">
	<dc:creator>Marc Stephenson via script</dc:creator>
	<gds:sourcenode>json/definitions/guid</gds:sourcenode>
		<gds:pattern>^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$</gds:pattern>
	<gds:type>string</gds:type>
				<rdfs:subClassOf rdf:resource="http://www.gov.uk/IA/Ontology/ContentType/Answer"/>
</owl:Class>

