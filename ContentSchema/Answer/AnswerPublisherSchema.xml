<json>
	<schema>http://json-schema.org/draft-04/schema#</schema>
	<type>object</type>
	<required>base_path</required>
	<required>details</required>
	<required>document_type</required>
	<required>publishing_app</required>
	<required>rendering_app</required>
	<required>routes</required>
	<required>schema_name</required>
	<required>title</required>
	<additionalProperties>false</additionalProperties>
	<properties>
		<access_limited>
			<ref>#/definitions/access_limited</ref>
		</access_limited>
		<analytics_identifier>
			<ref>#/definitions/analytics_identifier</ref>
		</analytics_identifier>
		<auth_bypass_ids>
			<description>A list of ids that will allow access to this item for non-authenticated users</description>
			<ref>#/definitions/guid_list</ref>
		</auth_bypass_ids>
		<base_path>
			<ref>#/definitions/absolute_path</ref>
		</base_path>
		<bulk_publishing>
			<type>boolean</type>
		</bulk_publishing>
		<change_note>
			<type>null</type>
			<type>string</type>
		</change_note>
		<description>
			<ref>#/definitions/description_optional</ref>
		</description>
		<details>
			<ref>#/definitions/details</ref>
		</details>
		<document_type>
			<type>string</type>
			<enum>answer</enum>
		</document_type>
		<first_published_at>
			<ref>#/definitions/first_published_at</ref>
		</first_published_at>
		<last_edited_at>
			<description>Last time when the content received a major or minor update.</description>
			<type>string</type>
			<format>date-time</format>
		</last_edited_at>
		<links>
			<type>object</type>
			<additionalProperties>false</additionalProperties>
			<properties>
				<policy_areas>
					<description>A largely deprecated tag currently only used to power email alerts.</description>
					<ref>#/definitions/guid_list</ref>
				</policy_areas>
			</properties>
		</links>
		<locale>
			<ref>#/definitions/locale</ref>
		</locale>
		<need_ids>
			<type>array</type>
			<items>
				<type>string</type>
			</items>
		</need_ids>
		<phase>
			<description>The service design phase of this content item - https://www.gov.uk/service-manual/phases</description>
			<type>string</type>
			<enum>alpha</enum>
			<enum>beta</enum>
			<enum>live</enum>
		</phase>
		<previous_version>
			<type>string</type>
		</previous_version>
		<public_updated_at>
			<ref>#/definitions/public_updated_at</ref>
		</public_updated_at>
		<publishing_app>
			<ref>#/definitions/publishing_app_name</ref>
		</publishing_app>
		<redirects>
			<type>array</type>
			<additionalItems>false</additionalItems>
			<items/>
		</redirects>
		<rendering_app>
			<ref>#/definitions/rendering_app</ref>
		</rendering_app>
		<routes>
			<ref>#/definitions/routes</ref>
		</routes>
		<schema_name>
			<type>string</type>
			<enum>answer</enum>
		</schema_name>
		<title>
			<ref>#/definitions/title</ref>
		</title>
		<update_type>
			<ref>#/definitions/update_type</ref>
		</update_type>
	</properties>
	<definitions>
		<description>
			<type>string</type>
		</description>
		<absolute_path>
			<description>A path only. Query string and/or fragment are not allowed.</description>
			<type>string</type>
			<pattern>^/(([a-zA-Z0-9._~!$&amp;'()*+,;=:@-]|%[0-9a-fA-F]{2})+(/([a-zA-Z0-9._~!$&amp;'()*+,;=:@-]|%[0-9a-fA-F]{2})*)*)?$</pattern>
		</absolute_path>
		<access_limited>
			<type>object</type>
			<additionalProperties>false</additionalProperties>
			<properties>
				<auth_bypass_ids>
					<description>Deprecated: auth_bypass_ids should be sent as a separate field</description>
					<ref>#/definitions/guid_list</ref>
				</auth_bypass_ids>
				<organisations>
					<description>A list of organisation content ids permitted access to this item</description>
					<ref>#/definitions/guid_list</ref>
				</organisations>
				<users>
					<type>array</type>
					<items>
						<type>string</type>
					</items>
				</users>
			</properties>
		</access_limited>
		<analytics_identifier>
			<description>A short identifier we send to Google Analytics for multi-valued fields. This means we avoid the truncated values we would get if we sent the path or slug of eg organisations.</description>
			<anyOf>
				<type>string</type>
			</anyOf>
			<anyOf>
				<type>null</type>
			</anyOf>
		</analytics_identifier>
		<body_html_and_govspeak>
			<description>The main content provided as HTML with the govspeak markdown it's rendered from</description>
			<anyOf>
				<ref>#/definitions/multiple_content_types</ref>
			</anyOf>
		</body_html_and_govspeak>
		<description_optional>
			<anyOf>
				<ref>#/definitions/description</ref>
			</anyOf>
			<anyOf>
				<type>null</type>
			</anyOf>
		</description_optional>
		<details>
			<type>object</type>
			<additionalProperties>false</additionalProperties>
			<properties>
				<body>
					<ref>#/definitions/body_html_and_govspeak</ref>
				</body>
				<external_related_links>
					<ref>#/definitions/external_related_links</ref>
				</external_related_links>
			</properties>
		</details>
		<external_link>
			<type>object</type>
			<required>title</required>
			<required>url</required>
			<additionalProperties>false</additionalProperties>
			<properties>
				<title>
					<type>string</type>
				</title>
				<url>
					<type>string</type>
					<format>uri</format>
				</url>
			</properties>
		</external_link>
		<external_related_links>
			<type>array</type>
			<items>
				<ref>#/definitions/external_link</ref>
			</items>
		</external_related_links>
		<first_published_at>
			<description>The date the content was first published.  Automatically determined by the publishing-api, unless overridden by the publishing application.</description>
			<type>string</type>
			<format>date-time</format>
		</first_published_at>
		<guid>
			<type>string</type>
			<pattern>^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$</pattern>
		</guid>
		<guid_list>
			<type>array</type>
			<items>
				<ref>#/definitions/guid</ref>
			</items>
			<uniqueItems>true</uniqueItems>
		</guid_list>
		<locale>
			<type>string</type>
			<enum>ar</enum>
			<enum>az</enum>
			<enum>be</enum>
			<enum>bg</enum>
			<enum>bn</enum>
			<enum>cs</enum>
			<enum>cy</enum>
			<enum>da</enum>
