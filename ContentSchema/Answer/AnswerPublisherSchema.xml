			<enum>vi</enum>
			<enum>yi</enum>
			<enum>zh</enum>
			<enum>zh-hk</enum>
			<enum>zh-tw</enum>
		</locale>
		<multiple_content_types>
			<type>array</type>
			<items>
				<type>object</type>
				<required>content_type</required>
				<required>content</required>
				<additionalProperties>false</additionalProperties>
				<properties>
					<content>
						<type>string</type>
					</content>
					<content_type>
						<type>string</type>
					</content_type>
				</properties>
			</items>
		</multiple_content_types>
		<public_updated_at>
			<description>When the content was last significantly changed (a major update). Shown to users.  Automatically determined by the publishing-api, unless overridden by the publishing application.</description>
			<type>string</type>
			<format>date-time</format>
		</public_updated_at>
		<publishing_app_name>
			<description>The application that published this item.</description>
			<type>string</type>
			<enum>account-api</enum>
			<enum>calculators</enum>
