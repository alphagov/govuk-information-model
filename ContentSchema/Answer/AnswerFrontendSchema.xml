<json>
	<schema>http://json-schema.org/draft-04/schema#</schema>
	<type>object</type>
	<required>base_path</required>
	<required>content_id</required>
	<required>description</required>
	<required>details</required>
	<required>document_type</required>
	<required>links</required>
	<required>locale</required>
	<required>public_updated_at</required>
	<required>schema_name</required>
	<required>title</required>
	<required>updated_at</required>
	<additionalProperties>false</additionalProperties>
	<properties>
		<analytics_identifier>
			<ref>#/definitions/analytics_identifier</ref>
		</analytics_identifier>
		<base_path>
			<ref>#/definitions/absolute_path</ref>
		</base_path>
		<content_id>
			<ref>#/definitions/guid</ref>
		</content_id>
		<description>
			<ref>#/definitions/description_optional</ref>
		</description>
		<details>
			<ref>#/definitions/details</ref>
		</details>
		<document_type>
			<type>string</type>
			<enum>answer</enum>
		</document_type>
		<first_published_at>
			<anyOf>
				<ref>#/definitions/first_published_at</ref>
			</anyOf>
			<anyOf>
				<type>null</type>
			</anyOf>
		</first_published_at>
		<links>
			<type>object</type>
			<additionalProperties>false</additionalProperties>
			<properties>
				<available_translations>
					<description>Link type automatically added by Publishing API</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
				</available_translations>
				<child_taxons>
					<description>Link type automatically added by Publishing API</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
				</child_taxons>
				<children>
					<description>Link type automatically added by Publishing API</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
				</children>
				<document_collections>
					<description>Link type automatically added by Publishing API</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
				</document_collections>
				<facet_groups>
					<description>Prototype-stage metadata tagging tree roots for this content item. A content item my belong to many facet groups without having any specific facet_values links.</description>
					<ref>#/definitions/frontend_links</ref>
				</facet_groups>
				<facet_values>
					<description>Prototype-stage metadata tagging values for this content item, a content item can be linked to many facet values from varying facet groups.</description>
					<ref>#/definitions/frontend_links</ref>
				</facet_values>
				<finder>
					<description>Powers links from content back to finders the content is surfaced on</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
				</finder>
				<lead_organisations>
					<description>DEPRECATED: A subset of organisations that should be emphasised in relation to this content item. All organisations specified here should also be part of the organisations array.</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
				</lead_organisations>
				<level_one_taxons>
					<description>Link type automatically added by Publishing API</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
				</level_one_taxons>
				<mainstream_browse_pages>
					<description>Powers the /browse section of the site. These are known as sections in some legacy apps.</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
				</mainstream_browse_pages>
				<meets_user_needs>
					<description>The user needs this piece of content meets.</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
				</meets_user_needs>
				<ministers>
					<description>Link type automatically added by Publishing API</description>
					<ref>#/definitions/frontend_links</ref>
				</ministers>
				<ordered_related_items>
					<description>Related items, can be any page on GOV.UK. Mostly used for mainstream content to power the sidebar. Ordering of the links is determined by the editor in Content Tagger.</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
				</ordered_related_items>
				<ordered_related_items_overrides>
					<description>Related items, can be any page on GOV.UK. Overrides 'more like this' automatically generated links in the beta navigation.</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
				</ordered_related_items_overrides>
				<organisations>
					<description>All organisations linked to this content item. This should include lead organisations.</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
				</organisations>
				<original_primary_publishing_organisation>
					<description>The organisation that published the original version of the page. Corresponds to the first of the 'Lead organisations' in Whitehall for the first edition, and is empty for all other publishing applications.</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
				</original_primary_publishing_organisation>
				<parent>
					<description>The parent content item.</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
					<maxItems>1</maxItems>
				</parent>
				<part_of_step_navs>
					<description>Link type automatically added by Publishing API</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
				</part_of_step_navs>
				<policies>
					<description>Link type automatically added by Publishing API</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
				</policies>
				<policy_areas>
					<description>A largely deprecated tag currently only used to power email alerts.</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
				</policy_areas>
				<primary_publishing_organisation>
					<description>The organisation that published the page. Corresponds to the first of the 'Lead organisations' in Whitehall, and is empty for all other publishing applications.</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
					<maxItems>1</maxItems>
				</primary_publishing_organisation>
				<related_to_step_navs>
					<description>Link type automatically added by Publishing API</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
				</related_to_step_navs>
				<role_appointments>
					<description>Link type automatically added by Publishing API</description>
					<ref>#/definitions/frontend_links</ref>
				</role_appointments>
				<secondary_to_step_navs>
					<description>Link type automatically added by Publishing API</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
				</secondary_to_step_navs>
				<suggested_ordered_related_items>
					<description>New A/B test suggestions for related items. Used for displaying related content on most pages, except for step-by-step and fatality notices. Links and their ordering are determined by the machine learning algorithms included in this A/B test.</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
				</suggested_ordered_related_items>
				<taxons>
					<description>Prototype-stage taxonomy label for this content item</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
				</taxons>
				<topic_taxonomy_taxons>
					<description>Link type automatically added by Publishing API</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
				</topic_taxonomy_taxons>
				<topics>
					<description>Powers the /topic section of the site. These are known as specialist sectors in some legacy apps.</description>
					<ref>#/definitions/frontend_links_with_base_path</ref>
				</topics>
			</properties>
		</links>
		<locale>
			<ref>#/definitions/locale</ref>
		</locale>
		<need_ids>
			<type>array</type>
			<items>
				<type>string</type>
			</items>
		</need_ids>
		<phase>
			<description>The service design phase of this content item - https://www.gov.uk/service-manual/phases</description>
			<type>string</type>
			<enum>alpha</enum>
			<enum>beta</enum>
			<enum>live</enum>
		</phase>
		<public_updated_at>
			<anyOf>
				<ref>#/definitions/public_updated_at</ref>
			</anyOf>
			<anyOf>
				<type>null</type>
			</anyOf>
		</public_updated_at>
		<publishing_app>
			<ref>#/definitions/publishing_app_name</ref>
		</publishing_app>
		<publishing_request_id>
			<ref>#/definitions/publishing_request_id</ref>
		</publishing_request_id>
		<publishing_scheduled_at>
			<anyOf>
				<ref>#/definitions/publishing_scheduled_at</ref>
			</anyOf>
			<anyOf>
				<type>null</type>
			</anyOf>
		</publishing_scheduled_at>
		<rendering_app>
			<ref>#/definitions/rendering_app</ref>
		</rendering_app>
		<scheduled_publishing_delay_seconds>
			<anyOf>
				<ref>#/definitions/scheduled_publishing_delay_seconds</ref>
			</anyOf>
			<anyOf>
				<type>null</type>
			</anyOf>
		</scheduled_publishing_delay_seconds>
		<schema_name>
			<type>string</type>
			<enum>answer</enum>
		</schema_name>
		<title>
			<ref>#/definitions/title</ref>
		</title>
		<updated_at>
			<type>string</type>
			<format>date-time</format>
		</updated_at>
		<withdrawn_notice>
			<ref>#/definitions/withdrawn_notice</ref>
		</withdrawn_notice>
	</properties>
	<definitions>
		<description>
			<type>string</type>
		</description>
		<absolute_path>
			<description>A path only. Query string and/or fragment are not allowed.</description>
			<type>string</type>
			<pattern>^/(([a-zA-Z0-9._~!$&amp;'()*+,;=:@-]|%[0-9a-fA-F]{2})+(/([a-zA-Z0-9._~!$&amp;'()*+,;=:@-]|%[0-9a-fA-F]{2})*)*)?$</pattern>
		</absolute_path>
		<analytics_identifier>
			<description>A short identifier we send to Google Analytics for multi-valued fields. This means we avoid the truncated values we would get if we sent the path or slug of eg organisations.</description>
			<anyOf>
				<type>string</type>
			</anyOf>
			<anyOf>
				<type>null</type>
			</anyOf>
		</analytics_identifier>
		<body_html_and_govspeak>
			<description>The main content provided as HTML with the govspeak markdown it's rendered from</description>
			<anyOf>
				<type>string</type>
			</anyOf>
		</body_html_and_govspeak>
		<change_history>
			<type>array</type>
			<items>
				<type>object</type>
				<required>public_timestamp</required>
				<required>note</required>
				<additionalProperties>false</additionalProperties>
				<properties>
					<note>
						<description>A summary of the change</description>
						<type>string</type>
					</note>
					<public_timestamp>
						<type>string</type>
						<format>date-time</format>
					</public_timestamp>
				</properties>
			</items>
		</change_history>
		<description_optional>
			<anyOf>
				<ref>#/definitions/description</ref>
			</anyOf>
			<anyOf>
				<type>null</type>
			</anyOf>
		</description_optional>
		<details>
			<type>object</type>
			<additionalProperties>false</additionalProperties>
			<properties>
				<body>
					<ref>#/definitions/body_html_and_govspeak</ref>
				</body>
				<change_history>
					<ref>#/definitions/change_history</ref>
				</change_history>
				<external_related_links>
					<ref>#/definitions/external_related_links</ref>
				</external_related_links>
			</properties>
		</details>
		<external_link>
			<type>object</type>
			<required>title</required>
			<required>url</required>
			<additionalProperties>false</additionalProperties>
			<properties>
				<title>
					<type>string</type>
				</title>
				<url>
					<type>string</type>
					<format>uri</format>
				</url>
			</properties>
		</external_link>
		<external_related_links>
			<type>array</type>
			<items>
				<ref>#/definitions/external_link</ref>
			</items>
		</external_related_links>
		<first_published_at>
			<description>The date the content was first published.  Automatically determined by the publishing-api, unless overridden by the publishing application.</description>
			<type>string</type>
			<format>date-time</format>
		</first_published_at>
		<frontend_links>
			<type>array</type>
			<items>
				<type>object</type>
				<required>content_id</required>
				<required>locale</required>
				<required>title</required>
				<additionalProperties>true</additionalProperties>
				<properties>
					<analytics_identifier>
						<ref>#/definitions/analytics_identifier</ref>
					</analytics_identifier>
					<api_path>
						<ref>#/definitions/absolute_path</ref>
					</api_path>
					<api_url>
						<description>DEPRECATED: api_path should be used instead of api_url. This is due to values of api_url being tied to an environment which can cause problems when data is synced between environments. In time this field will be removed by the Publishing Platform team.</description>
						<type>string</type>
						<format>uri</format>
					</api_url>
					<base_path>
						<ref>#/definitions/absolute_path</ref>
					</base_path>
					<content_id>
						<ref>#/definitions/guid</ref>
					</content_id>
					<document_type>
						<type>string</type>
					</document_type>
					<links>
						<type>object</type>
						<patternProperties>
							<a-z_>
								<ref>#/definitions/frontend_links</ref>
							</a-z_>
						</patternProperties>
					</links>
					<locale>
						<ref>#/definitions/locale</ref>
					</locale>
					<public_updated_at>
						<oneOf>
							<ref>#/definitions/public_updated_at</ref>
						</oneOf>
						<oneOf>
							<type>null</type>
						</oneOf>
					</public_updated_at>
					<schema_name>
						<type>string</type>
					</schema_name>
					<title>
						<type>string</type>
					</title>
					<web_url>
						<description>DEPRECATED: base_path should be used instead of web_url. This is due to values of web_url being tied to an environment which can cause problems when data is synced between environments. In time this field will be removed by the Publishing Platform team.</description>
						<type>string</type>
						<format>uri</format>
					</web_url>
				</properties>
			</items>
		</frontend_links>
		<frontend_links_with_base_path>
			<type>array</type>
			<items>
				<type>object</type>
				<required>base_path</required>
				<required>content_id</required>
				<required>locale</required>
				<required>title</required>
				<additionalProperties>true</additionalProperties>
				<properties>
					<analytics_identifier>
						<ref>#/definitions/analytics_identifier</ref>
					</analytics_identifier>
					<api_path>
						<ref>#/definitions/absolute_path</ref>
					</api_path>
					<api_url>
						<description>DEPRECATED: api_path should be used instead of api_url. This is due to values of api_url being tied to an environment which can cause problems when data is synced between environments. In time this field will be removed by the Publishing Platform team.</description>
						<type>string</type>
						<format>uri</format>
					</api_url>
					<base_path>
						<ref>#/definitions/absolute_path</ref>
					</base_path>
					<content_id>
						<ref>#/definitions/guid</ref>
					</content_id>
					<document_type>
						<type>string</type>
					</document_type>
					<links>
						<type>object</type>
						<patternProperties>
							<a-z_>
								<ref>#/definitions/frontend_links_with_base_path</ref>
							</a-z_>
						</patternProperties>
					</links>
					<locale>
						<ref>#/definitions/locale</ref>
					</locale>
					<public_updated_at>
						<oneOf>
							<ref>#/definitions/public_updated_at</ref>
						</oneOf>
						<oneOf>
							<type>null</type>
						</oneOf>
					</public_updated_at>
					<schema_name>
						<type>string</type>
					</schema_name>
					<title>
						<type>string</type>
					</title>
					<web_url>
						<description>DEPRECATED: base_path should be used instead of web_url. This is due to values of web_url being tied to an environment which can cause problems when data is synced between environments. In time this field will be removed by the Publishing Platform team.</description>
						<type>string</type>
						<format>uri</format>
					</web_url>
				</properties>
			</items>
		</frontend_links_with_base_path>
		<guid>
			<type>string</type>
			<pattern>^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$</pattern>
