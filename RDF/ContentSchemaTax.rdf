    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:Ontologygds="https://gov.uk/ontologygds:"
    xmlns="https://gov.uk/ontology/ContentSchemaTax#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
  <owl:Ontology rdf:about="https://gov.uk/ontology/ContentSchemaTax">
    <owl:imports rdf:resource="https://gov.uk/ontology/Core"/>
    <owl:versionIRI rdf:resource="https://gov.uk/ontology/ContentSchemaTax"/>
  </owl:Ontology>
  <owl:Class rdf:about="https://gov.uk/ontology#ContentSchema">
    <rdfs:label xml:lang="en-GB">Content Block</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://gov.uk/ontology/ContentSchemaTax#TaxName">
    <rdfs:label xml:lang="en-GB">Tax Name</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="https://gov.uk/ontology/ContentSchemaTax#Tax"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://gov.uk/ontology/ContentSchemaTax#InstructionToPublishers">
    <rdfs:label xml:lang="en-GB">Instructions to publishers</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="https://gov.uk/ontology/ContentSchemaTax#Tax"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://gov.uk/ontology/ContentSchemaTax#Part2">
    <rdfs:subClassOf rdf:resource="https://gov.uk/ontology/ContentSchemaTax#InstructionToPublishers"/>
  </owl:Class>
  <owl:Class rdf:about="https://gov.uk/ontology/ContentSchemaTax#Part1">
    <owl:disjointWith rdf:resource="https://gov.uk/ontology/ContentSchemaTax#Part2"/>
    <rdfs:subClassOf rdf:resource="https://gov.uk/ontology/ContentSchemaTax#InstructionToPublishers"/>
  </owl:Class>
  <owl:Class rdf:about="https://gov.uk/ontology/ContentSchemaTax#Part3">
    <rdfs:subClassOf>
      <owl:Class rdf:about="https://gov.uk/ontology/ContentSchemaTax#Note"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://gov.uk/ontology/ContentSchemaTax#Synonym">
    <rdfs:label xml:lang="en-GB">Synonym</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="https://gov.uk/ontology/ContentSchemaTax#Tax"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://gov.uk/ontology/ContentSchemaTax#LeadOrganisation">
    <rdfs:label xml:lang="en-GB">Lead Organisation</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="https://gov.uk/ontology/ContentSchemaTax#Tax"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://gov.uk/ontology/ContentSchemaTax#Abbreviation">
    <rdfs:label xml:lang="en-GB">Abbreviation</rdfs:label>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:onProperty rdf:resource="https://gov.uk/ontology#hasDatatype"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:about="https://gov.uk/ontology/ContentSchemaTax#Tax"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://gov.uk/ontology/ContentSchemaTax#Description">
    <rdfs:label xml:lang="en-GB">Description</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="https://gov.uk/ontology/ContentSchemaTax#Tax"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://gov.uk/ontology/ContentSchemaTax#Note">
    <rdfs:label xml:lang="en-GB">Note</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="https://gov.uk/ontology/ContentSchemaTax#Tax"/>
    </rdfs:subClassOf>
