  <owl:Class rdf:about="https://gov.uk/ontology/ContentSchemaTax#Part3a">
    <rdfs:subClassOf rdf:resource="https://gov.uk/ontology/ContentSchemaTax#Part3"/>
  </owl:Class>
  <owl:Class rdf:about="https://gov.uk/ontology/ContentSchemaTax#Tax">
    <rdfs:label xml:lang="en-GB">Tax Content Block</rdfs:label>
    <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime"
